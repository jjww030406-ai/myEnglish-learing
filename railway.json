{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python server.py",
    "restartPolicyType": "on_failure",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100
  }
}
